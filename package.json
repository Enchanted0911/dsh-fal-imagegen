{
  "name": "dsh-fal-imagegen",
  "version": "0.2.0",
  "description": "fal.ai native image generation for DSH: a FAL_KEY settings card that follows DSH's language (zh/en, English default) plus Agent tools (fal_generate_image async / fal_edit_image / fal_get_image_task / fal_list_image_models) that call queue.fal.run directly — Authorization: Key, queue polling, images[].url.",
  "license": "MIT",
  "author": "wujunsheng",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "fal",
    "fal.ai",
    "image-generation",
    "text-to-image",
    "image-to-image",
    "agent-tools"
  ],
  "homepage": "https://github.com/Enchanted0911/dsh-fal-imagegen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enchanted0911/dsh-fal-imagegen.git"
  },
  "bugs": {
    "url": "https://github.com/Enchanted0911/dsh-fal-imagegen/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.zh.md",
    "README.es.md",
    "README.ar.md",
    "README.fr.md",
    "README.ja.md",
    "README.ko.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "node tests/fal-publish-test.mjs && node tests/fal-manifest-test.mjs && node tests/fal-client-test.mjs && node tests/fal-settings-roundtrip-test.mjs && node tests/fal-schema-test.mjs && node tests/fal-tasks-test.mjs",
    "catalog:static": "node catalog/build-static.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-tools": "*",
    "schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
